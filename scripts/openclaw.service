[Unit]
Description=OpenClaw Agent Gateway Daemon
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/agentic-api-conformance-checker
EnvironmentFile=/home/ubuntu/agentic-api-conformance-checker/.env
ExecStart=/home/ubuntu/.npm-global/bin/openclaw gateway
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openclaw

[Install]
WantedBy=multi-user.target

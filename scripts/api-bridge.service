[Unit]
Description=API Conformance Bridge (FastAPI + OpenClaw HTTP Gateway)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/agentic-api-conformance-checker
EnvironmentFile=/home/ubuntu/agentic-api-conformance-checker/.env
ExecStart=/home/ubuntu/.local/bin/uv run python /home/ubuntu/agentic-api-conformance-checker/api_bridge.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=api-bridge

[Install]
WantedBy=multi-user.target

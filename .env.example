# LLM
LLM_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings (local, no rate limits)
EMBED_PROVIDER=sentence-transformers
EMBED_MODEL=all-MiniLM-L6-v2

# Qdrant (Must match the exact collection seeded by parse_corpus.py)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=compliance_rules

# Postgres
POSTGRES_URL=postgresql://postgres:postgrespassword@localhost:5432/conformance_checker
POSTGRES_PASSWORD=postgrespassword

# MCP Server
MCP_SERVER_PORT=3000

# Agent
SIMILARITY_THRESHOLD=0.65
ASVS_CHAPTERS_FILTER=1,3,4,13,14

# --- LLM ROUTING ROUTER ---
# Choose your active infrastructure provider: "groq" or "gemini"
LLM_PROVIDER=

# If using Groq:
LLM_API_KEY=
GROQ_MODEL=

# If using Gemini:
GEMINI_API_KEY=
GEMINI_MODEL=

# --- EMBEDDINGS (Local, zero rate limits) ---
EMBED_PROVIDER=sentence-transformers
EMBED_MODEL=all-MiniLM-L6-v2

# --- VECTOR STORAGE (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=compliance_rules

# --- DATABASE PERSISTENCE (PostgreSQL) ---
POSTGRES_URL=postgresql://postgres:postgrespassword@localhost:5432/conformance_checker
POSTGRES_PASSWORD=postgrespassword

# --- MCP PROTOCOL SETTINGS ---
MCP_SERVER_PORT=3000

# --- AGENT BEHAVIOR CALIBRATION ---
SIMILARITY_THRESHOLD=0.45
ASVS_CHAPTERS_FILTER=1,3,4,13,14

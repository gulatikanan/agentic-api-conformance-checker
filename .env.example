# ====================================================================
# 🧠 CORE AI INFERENCE CONFIGURATION
# ====================================================================
LLM_PROVIDER=gemini
# Change this to switch models — api_bridge.py reads it at startup, no code edits needed
# e.g. gemini-2.5-flash | gemini-1.5-pro | gemini-1.5-flash
GEMINI_MODEL=google/gemini-2.5-flash
GEMINI_API_KEY=AIzaSyYourSecretKeyGoesHere

# ====================================================================
# 🔌 INFRASTRUCTURE COORDINATES & ROUTING BOUNDARIES
# ====================================================================
# Vector DB (Docker Container)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=compliance_rules

# Relational Analytics DB (Docker Container)
POSTGRES_URL=postgresql://postgres:postgrespassword@localhost:5432/conformance_checker

# ====================================================================
# 🛡️ ALGORITHMIC GUARDRAILS & SAFETY METRICS
# ====================================================================
# Strict cosine similarity cutoff constraint to block hallucinations
SIMILARITY_THRESHOLD=0.45

# LLM Provider Configuration
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_placeholder_key_please_replace_with_your_actual_key
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding Model Configuration (For Phase 4 Ingestion)
EMBED_PROVIDER=sentence-transformers
EMBED_MODEL=all-MiniLM-L6-v2

# Infrastructure Vector Layer
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=conformance_rules

# Infrastructure Relational Layer
POSTGRES_URL=postgresql://user:password@localhost:5432/conformance_db

# Protocol Layer
MCP_SERVER_PORT=3000
SIMILARITY_THRESHOLD=0.65
